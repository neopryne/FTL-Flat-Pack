	<event name="NPC_STORAGE_CHECK_CREATE_FM_CHAINGUN_FIRE">
		<checkCargo/>
		<text>Currently viewing the 'Hellflash' Gatling Gun.</text>
		<choice>
			<text>Craft the 'Hellflash' Gatling Gun.</text>
			<event>
				<text id="text_CREATE_FM_CHAINGUN_FIRE_1_1"/>
				<weapon name="FM_CHAINGUN_FIRE"/>
				<item_modify>
					<item type="scrap" min="-30" max="-30"/>
				</item_modify>
				<choice hidden="true">
					<text>Continue...</text>
					<event>
						<text id="text_CREATE_FM_CHAINGUN_FIRE_1_2"/>
						<remove name="LASER_FIRE"/>
						<choice hidden="true">
							<text>Continue...</text>
							<event>
								<text id="text_CREATE_FM_CHAINGUN_FIRE_1_3"/>
								<remove name="LASER_CHAINGUN_2"/>
								<choice hidden="true">
									<text>Continue...</text>
									<event>
										<metaVariable name="FM_LORE_CHAINGUN_FIRE" op="set" val="1"/>
										<text id="text_CREATE_FM_CHAINGUN_FIRE_1_4"/>
										<choice hidden="true">
											<text>Continue...</text>
											<event load="FM_FORGE_WEAPON_LOAD"/>
										</choice>
									</event>
								</choice>
							</event>
						</choice>
					</event>
				</choice>
			</event>
		</choice>
		<choice>
			<text>Nevermind.</text>
			<event load="FM_FORGE_WEAPON_LASER_LOAD"/>
		</choice>
	</event>