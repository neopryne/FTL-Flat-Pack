		<choice req="FM_ENERGY_RAILBLENDER_LIST_PLUS" blue="false">
			<text>Craft the Railblender+ using the Energy Charger+.</text>
			<event>
				<text>Proceed with crafting?</text>
				<weapon name="FM_ENERGY_RAILBLENDER_PLAYER"/>
				<item_modify>
					<item type="scrap" min="-140" max="-140"/>
				</item_modify>
				<removeItem>SHOTGUN_CHARGE</removeItem>
				<removeItem>ENERGY_CHARGEGUN_PLAYER</removeItem>
				<choice hidden="true">
					<text>Continue...</text>
					<event>
						<loadEvent>FM_FORGE_WEAPON_LOAD</loadEvent>
					</event>
				</choice>
			</event>
		</choice>
		<choice req="FM_ENERGY_RAILBLENDER_LIST" blue="false">
			<text>Craft the Railblender using the Energy Charger.</text>
			<event>
				<text>Proceed with crafting?</text>
				<weapon name="FM_ENERGY_RAILBLENDER"/>
				<item_modify>
					<item type="scrap" min="-140" max="-140"/>
				</item_modify>
				<removeItem>SHOTGUN_CHARGE</removeItem>
				<removeItem>ENERGY_CHARGEGUN</removeItem>
				<choice hidden="true">
					<text>Continue...</text>
					<event>
						<loadEvent>FM_FORGE_WEAPON_LOAD</loadEvent>
					</event>
				</choice>
			</event>
		</choice>
		<choice>
			<text>Nevermind.</text>
			<event load="FM_FORGE_WEAPON_FLAK_LOAD"/>
		</choice>
	</event>

