	</event>


	<event name="FORGEMASTER_SECOND_PROMPT" > <!--  Triggers if you visit the store, then try to jump -->
		<text>Alastair speaks up over your comms "Before you go lad, are you sure you don't need to craft anything?</text>
		<eventAlias name="STORAGE_CHECK_REAL" jumpClear="true"></eventAlias>
		<eventAlias name="FORGEMASTER_PHONE_EVENT" jumpClear="true">FORGEMASTER_SECOND_PROMPT_LOAD</eventAlias>

		<choice hidden="true" req="pilot" lvl="1" blue="false"> <!--  Do nothing for now -->
			<text>Just a moment please.</text>
			<event>
				<text>"Take your time, lad!"</text>
			</event>
		</choice>

		<choice hidden="true" req="FM_FORGE_LIST_CHECK" lvl="1" max_group="3" blue="true"> <!--  CRAFT MENU -->
			<text>Forge a new weapon, for a price.</text>
			<event load="FM_NPC_CREATE"/>
		</choice>

		<choice hidden="true" req="pilot" lvl="1" max_group="3" blue="false"> <!--  CRAFT MENU CHANGE THIS SO IT CALLS FM_NPC_CREATE_NONE EVENTUALLY, SO HE HAS DIFFERENT DIALOGUE FOR NO INGREDIENTS IF POSSIBLE -->
			<text>Check Forge recipes.</text>
			<event load="FM_NPC_CREATE_NONE"/>
		</choice>
		
		<choice req="pilot" lvl="1" blue="false" max_group="4">
			<text>Check the "Modular Hull" section on your way out.</text>
			<event>
				<loadEvent>FM_MODULAR_HULL_MAIN_LOAD</loadEvent>
			</event>
		</choice>


		<choice hidden="true" req="pilot" lvl="1" max_group="5" blue="false"> <!--  ATTACK -->
			<text>Attack while his guard is down!!</text>
			<event load="FM_ATTACK_SECOND"/>
		</choice>

		<choice hidden="true" req="pilot" lvl="1" max_group="7" blue="false"> <!--  Do nothing -->
			<text>Decline his offer.</text>
			<event>
				<text>"Perhaps later, lad! I'm sure if you come back with some interesting things, I'll be able to find you something extraordinary."</text>
				<eventAlias name="FORGEMASTER_PHONE_EVENT"></eventAlias>
				<clearEventButton name="UI_FORGEMASTER_SECOND_PROMPT"/>
				<choice>
					<text>Do something onboard the ship.</text>
					<event load="STORAGE_CHECK"/>
				</choice>
				<choice>
					<text>Do nothing.</text>
					<event/>
				</choice>
			</event>
		</choice>
	</event>


	<!--Fixes for bad menuing-->
	<event name="NPC_STORAGE_CHECK_CREATE_FM_SHOTGUN_AETHER">
		<checkCargo/>
		<text>Currently viewing the Aetheric Flak.</text>
		<choice req="FM_SHOTGUN_AETHER_LIST" lvl="1" blue="false" hidden="true">
			<text>Craft the Aetheric Flak.</text>
			<event>
				<text>Proceed with crafting?</text>
				<weapon name="FM_SHOTGUN_AETHER"/>
				<item_modify>
					<item type="scrap" min="-60" max="-60"/>
				</item_modify>
				<removeItem>SHOTGUN_4</removeItem>
				<choice hidden="true">
					<text>Continue...</text>
					<event>
						<loadEvent>FM_FORGE_WEAPON_LOAD</loadEvent>
					</event>
				</choice>
			</event>
		</choice>
		<choice>
			<text>Nevermind.</text>
			<event load="FM_FORGE_WEAPON_FLAK_LOAD"/>
		</choice>
	</event>

