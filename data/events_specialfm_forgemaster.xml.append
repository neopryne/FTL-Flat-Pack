		<choice>
			<text>Reconfigure a Stun Bomb to disperse the debilitating crystalline particles of a Neural Crystal to forge the IMPRISMENT Inducer. [Cost: 25-55~]</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_IMPRISMENT_INDUCER"/>
		</choice>

		<choice >
			<text>[GO BALLISTIC] Combine two to four Autocannon 1s to forge the Volley Gun. [Cost: 20-60~]</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_RVS_AC_CHARGE"/>
		</choice>
		
		<choice>
			<text>[GO BALLISTIC + CNC] Combine two Autocannon 2s and V5 Missiles to forge the 'Mammoth' Cannon. [Cost: 60~]</text>
			<event load="NPC_STORAGE_CHECK_CREATE_MAMMOTH_CANNON"/>
