	<!--COMBAT DRONE CRAFT CATEGORY-->
	<event name="FM_FORGE_COMBAT_DRONE_LOAD">
		<loadEvent>FM_FORGE_COMBAT_DRONE</loadEvent>
	</event>

	<event name="FM_FORGE_COMBAT_DRONE">
		<text>Which combat drone would you like to craft?</text>
		<checkCargo/>

		<choice req="FM_ENERGY_COMBAT_BEAM1_LIST" lvl="1" blue="false" hidden="true">
			<text>Align the central energy core of the Amp Energy Drone with the lenses of the Combat Drone MK. II's beam weapon to forge the 'Somebody Else Name This (Boo Womp)' Energy Beam Drone.[Cost: 37~]</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_ENERGY_COMBAT_BEAM1"/>
		</choice>

		<choice req="FM_ENERGY_COMBAT_BEAM1_LIST" lvl="0" max_lvl="0" blue="false" hidden="true">
			<text>You must have an Amp Energy Drone and Combat Drone MK II to forge this drone.</text>
			<event load="OPTION_INVALID"/>
		</choice>
		
		
		<choice req="FM_AMBER_DRONE_LIST" lvl="1" blue="false" hidden="true">
			<text>Overcharge the lattice of the Crystal Heavy MK I with the Assault Drone's particles to forge the Amber Combat Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_AMBER_DRONE"/>
		</choice>

		<choice req="FM_AMBER_DRONE_LIST" lvl="0" max_lvl="0" blue="false" hidden="true">
			<text>You must have a Crystal Heavy MK I and an Assault Drone to forge this drone.</text>
			<event load="OPTION_INVALID"/>
		</choice>

		<choice req="FM_CRYSTAL_DRONE_LIST" lvl="1" blue="false" hidden="true">
			<text>Calibrate the resonant frequencies of the Crystal Scatter's projectiles using the core of the Assault Drone to forge the Crystal Combat Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_CRYSTAL_DRONE"/>
		</choice>

		<choice req="FM_CRYSTAL_DRONE_LIST" lvl="0" max_lvl="0" blue="false" hidden="true">
			<text>You must have a Crystal Scatter and an Assault Drone to forge this drone.</text>
			<event load="OPTION_INVALID"/>
		</choice>

		<choice req="FM_CURA_DRONE_LIST" lvl="1" blue="false" hidden="true">
			<text>Further optimize the Conservative Combat Drone's reactor and algorithms with the Manager Drone's computer, while constructing a makeshift drone factory with the Battle Drone MK I's blueprint.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_CURA_DRONE"/>
		</choice>

		<choice req="FM_CURA_DRONE_LIST" lvl="0" max_lvl="0" blue="false" hidden="true">
			<text>You must have a Manager Drone, Conservative Combat Drone, and Battle Drone MK I to forge this drone.</text>
			<event load="OPTION_INVALID"/>
		</choice>

		<choice req="FM_FLAMETHROWER_DRONE_LIST" lvl="1" blue="false" hidden="true">
			<text>Infuse your Assault Drone with the essence of a ghost to craft the Dazhbog Flamethrower Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_FLAMETHROWER_DRONE"/>
		</choice>

		<choice req="FM_FLAMETHROWER_DRONE_LIST" lvl="0" max_lvl="0" blue="false" hidden="true">
			<text>You must have an Assault Drone and gaseous form to forge this drone.</text>
			<event load="OPTION_INVALID"/>
		</choice>

		<choice req="FM_FORGEMAN_DRONE_LIST" lvl="1" blue="false" hidden="true">
			<text>Have your Plated use their expertise in the art of the forge to convert your Combat Drone MK II into the Forgemaster Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_FORGEMAN_DRONE"/>
		</choice>
		
		<choice req="FM_FORGEMAN_DRONE_LIST" lvl="0" max_lvl="0" blue="false" hidden="true">
			<text>You must have a Combat Drone MK II and an expert craftsperson to forge this drone.</text>
			<event load="OPTION_INVALID"/>
		</choice>

		<choice req="FM_ISHIMURA_DRONE_LIST" lvl="1" blue="false" hidden="true">
			<text>Create a feedback loop between the beams of the Stiletto and Amp Pinpoint Drone to craft the Ishimura Beam Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_ISHIMURA_DRONE"/>
		</choice>

		<choice req="FM_ISHIMURA_DRONE_LIST" lvl="0" max_lvl="0" blue="false" hidden="true">
			<text>You must have a Stiletto Pinpoint and Amp Pinpoint Drone to forge this drone.</text>
			<event load="OPTION_INVALID"/>
		</choice>

		<choice req="FM_KESTREL_DRONE_LIST" lvl="1" blue="false" hidden="true">
			<text>Install the internal loading mechanism of the Burst Laser MK II into the Combat Drone MK I to craft the Kestrel Combat Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_KESTREL_DRONE"/>
		</choice>

		<choice req="FM_KESTREL_DRONE_LIST" lvl="0" max_lvl="0" blue="false" hidden="true">
			<text>You must have a Burst Laser MK II and Combat Drone MK I to forge this drone.</text>
			<event load="OPTION_INVALID"/>
		</choice>

		<choice req="FM_MFK_KESTREL_DRONE_LIST" lvl="1" blue="false" hidden="true">
			<text>Install the Light Laser MK I into the Combat Drone MK I's chassis to craft the MFK Kestrel Combat Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_MFK_KESTREL_DRONE"/>
		</choice>
		
		<choice req="FM_MFK_KESTREL_DRONE_LIST" lvl="0" max_lvl="0" blue="false" hidden="true">
			<text>You must have a Light Laser MK I and Combat Drone MK I to forge this drone.</text>
			<event load="OPTION_INVALID"/>
		</choice>

		<choice req="FM_MFK_PICKET_DRONE_LIST" lvl="1" blue="false" hidden="true">
			<text>Utilize the Recon Drone's data suite to reconfigure your external Teleporter tech into the MFK Picket Teleporter Relay.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_MFK_PICKET_DRONE"/>
		</choice>

		<choice req="FM_MFK_PICKET_DRONE_LIST" lvl="0" max_lvl="0" blue="false" hidden="true">
			<text>You must have a Recon Drone and the External Reconstructive Teleporter augment to forge this drone.</text>
			<event load="OPTION_INVALID"/>
		</choice>

		<choice req="FM_SIREN_DRONE_LIST" lvl="1" blue="false" hidden="true">
			<text>Extract the nerve-disrupting components of the Stun Bomb and integrate them into the Pest Drone to forge the Siren Combat Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_SIREN_DRONE"/>
		</choice>

		<choice req="FM_SIREN_DRONE_LIST" lvl="0" max_lvl="0" blue="false" hidden="true">
			<text>You must have a Stun Bomb and Pest Drone to forge this drone.</text>
			<event load="OPTION_INVALID"/>
		</choice>

		<!--Back to main craft menu-->
		<choice req="pilot" lvl="1" max_group="20" hidden="true" blue="false">
			<text>Nevermind, back to main menu.</text>
			<event load="FM_FORGE_WEAPON_LOAD"/>
		</choice>
	</event>


