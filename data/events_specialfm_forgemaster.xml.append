	<!--COMBAT DRONE CRAFT CATEGORY-->
	<event name="FM_FORGE_COMBAT_DRONE_LOAD">
		<loadEvent>FM_FORGE_COMBAT_DRONE</loadEvent>
	</event>

	<event name="FM_FORGE_COMBAT_DRONE">
		<text>Which combat drone would you like to craft?</text>
		<checkCargo/>

		<!--Back to main craft menu-->
		<choice req="pilot" blue="false">
			<text>Nevermind, back to main menu.</text>
			<event load="FM_FORGE_WEAPON_LOAD"/>
		</choice>

		<choice>
			<text>Align the central energy core of an Amp Energy Drone with the lenses of a Combat Drone MK. II's beam weapon to forge the 'Somebody Else Name This (Boo Womp)' Energy Beam Drone. [Cost: 37~]</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_ENERGY_COMBAT_BEAM1"/>
		</choice>
		
		<choice>
			<text>Overcharge the lattice of a Crystal Heavy MK I with an Assault Drone's particles to forge the Amber Combat Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_AMBER_DRONE"/>
		</choice>

		<choice>
			<text>Calibrate the resonant frequencies of a Crystal Scatter's projectiles using the core of an Assault Drone to forge the Crystal Combat Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_CRYSTAL_DRONE"/>
		</choice>

		<choice>
			<text>Further optimize a Conservative Combat Drone's reactor and algorithms with a Manager Drone's computer, while constructing a makeshift drone factory with a Battle Drone MK I's blueprint.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_CURA_DRONE"/>
		</choice>

		<choice>
			<text>Infuse an Assault Drone with the essence of a ghost to craft the Dazhbog Flamethrower Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_FLAMETHROWER_DRONE"/>
		</choice>

		<choice>
			<text>Have an expert craftsperson work their art on a Combat Drone MK II to create the Forgemaster Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_FORGEMAN_DRONE"/>
		</choice>

		<choice>
			<text>Create a feedback loop between the beams of a Stiletto and Amp Pinpoint Drone to craft the Ishimura Beam Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_ISHIMURA_DRONE"/>
		</choice>

		<choice>
			<text>Install the internal loading mechanism of a Burst Laser MK II into a Combat Drone MK I to craft the Kestrel Combat Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_KESTREL_DRONE"/>
		</choice>

		<choice>
			<text>Install a Light Laser MK I into a Combat Drone MK I's chassis to craft the MFK Kestrel Combat Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_MFK_KESTREL_DRONE"/>
		</choice>

		<choice>
			<text>Utilize a Recon Drone's data suite to reconfigure reconstructive teleporter tech into the MFK Picket Teleporter Relay.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_MFK_PICKET_DRONE"/>
		</choice>

		<choice>
			<text>Extract the nerve-disrupting components of a Stun Bomb and integrate them into a Pest Drone to forge the Siren Combat Drone.</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_SIREN_DRONE"/>
		</choice>
	</event>

	<!--ORGANIC CRAFT CATEGORY-->
	<event name="FM_FORGE_WEAPON_ORGANIC_LOAD">	<!--ORGANIC CRAFT CATEGORY-->
		<loadEvent>FM_FORGE_WEAPON_ORGANIC</loadEvent>
	</event>
	<event name="FM_FORGE_WEAPON_ORGANIC">
		<text>Which weapon would you like to craft?</text>
		<checkCargo/>

		<choice req="pilot" lvl="1" blue="false">
			<text>Nevermind.</text>
			<event load="FM_FORGE_WEAPON_LOAD"/>
		</choice>

		<choice req="FM_BEAM_BASILISK_FORGE_LIST" lvl="1" blue="false" hidden="true" max_group="1">
			<text>Your Leech is eyeing your Elite Kernel weapon hungrily...</text>
			<event load="NPC_STORAGE_CHECK_CREATE_FM_BEAM_BASILISK"/>
		</choice>

		<choice req="FM_BEAM_BASILISK_FORGE_LIST" lvl="0" max_lvl="0" blue="false" hidden="true" max_group="1">
			<text>You must have a truly ravenous creature and a high-quality salad to sate its appetite to forge this weapon.</text>
			<event load="OPTION_INVALID"/>
		</choice>
	</event>

	<!--UPGRADE CRAFT CATEGORY-->
	<event name="FM_FORGE_WEAPON_UPGRADE_LOAD">	<!--UPGRADE CRAFT CATEGORY-->
		<loadEvent>FM_FORGE_WEAPON_UPGRADE</loadEvent>
	</event>
	<event name="FM_FORGE_WEAPON_UPGRADE">
		<text>Which weapon would you like to craft?</text>
		<checkCargo/>
		<choice req="pilot" lvl="1" blue="false">
			<text>Nevermind.</text>
			<event load="FM_FORGE_WEAPON_LOAD"/>
		</choice>

		<choice req="FM_SHOTGUN_BRONZE_LIST_UPGRADE" lvl="1" blue="false" hidden="true" max_group="1">
			<text>Upgrade the Metal Flak Line</text>
			<event load="NPC_STORAGE_CHECK_UPGRADE_LISTFULL_LOAD"/>
		</choice>

		<choice req="FM_SHOTGUN_BRONZE_LIST_UPGRADE" lvl="0" max_lvl="0" blue="false" hidden="true" max_group="1">
			<text>You require a Bronze Flak-Line weapon Tier 1--->Tier 9 to proceed</text>
			<event load="OPTION_INVALID"/>
		</choice>
	</event>
